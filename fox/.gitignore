# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Environment
.env
*.env.local

# Logs
*.log

# Fox vault contents (target data, creds, etc)
vault/targets/*
!vault/targets/.gitkeep
vault/combos/*
!vault/combos/.gitkeep
vault/hashes/*
!vault/hashes/.gitkeep
vault/tokens/*
!vault/tokens/.gitkeep
vault/keys/*
!vault/keys/.gitkeep
vault/sessions/*
!vault/sessions/.gitkeep
vault/cracking/*
!vault/cracking/.gitkeep
vault/logs/*
!vault/logs/.gitkeep
!vault/.gitkeep

# Multibrain session (regenerated each time)
multibrain/session.md
multibrain/context/*
!multibrain/context/.gitkeep
!multibrain/.gitkeep
multibrain/indexes/*
!multibrain/indexes/.gitkeep
!multibrain/indexes/training.md

# Training validation results (generated)
training/validation/results/*
!training/validation/results/.gitkeep

# Python cache
__pycache__/
*.pyc
